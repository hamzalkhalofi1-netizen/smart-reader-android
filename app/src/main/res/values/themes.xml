<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme — dark Material3 -->
    <style name="Theme.SmartReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="chipStyle">@style/SmartReader.Chip</item>
    </style>

    <!-- Splash screen theme — used only for SplashActivity -->
    <style name="Theme.SmartReader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartReader</item>
    </style>

    <!-- Chip style -->
    <style name="SmartReader.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">true</item>
        <item name="chipIconTint">@color/primary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

</resources>
